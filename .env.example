# ─── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/halflife?schema=public"  # Postgres connection string; Orchard supplies this in production
BETTER_AUTH_SECRET=                            # 32+ random bytes (`openssl rand -base64 32`). Rotating it invalidates every session
BETTER_AUTH_URL=http://localhost:3000          # Public origin; must exactly match the registered OAuth redirect base, no trailing slash
NEXT_PUBLIC_APP_URL=http://localhost:3000      # Same value, exposed to the browser for absolute links

# ─── Hack Club Auth (identity, Slack ID, YSWS verification status) ────────────
HCA_CLIENT_ID=                                 # OAuth client id from auth.hackclub.com; request one per environment
HCA_CLIENT_SECRET=                             # OAuth client secret
HCA_DISCOVERY_URL=https://auth.hackclub.com/.well-known/openid-configuration  # OIDC discovery document
PULL_HCA_PII=false                             # true also requests address+birthdate scopes; requires PII_ENCRYPTION_KEY
PII_ENCRYPTION_KEY=                            # HKDF input for AES-256-GCM at-rest encryption. Losing it makes stored PII unrecoverable

# ─── Hackatime (coding hours for firmware work) ───────────────────────────────
HACKATIME_CLIENT_ID=                           # OAuth client id for linking a Hackatime identity
HACKATIME_CLIENT_SECRET=                       # OAuth client secret
HACKATIME_API_BASE=https://hackatime.hackclub.com  # Base URL of the Hackatime API

# ─── Uploads (Cloudflare R2, S3-compatible) ──────────────────────────────────
S3_ACCESS_KEY_ID=                              # R2 access key id
S3_SECRET_ACCESS_KEY=                          # R2 secret access key
S3_BUCKET_NAME=                                # Bucket holding journal images and timelapses
S3_ENDPOINT=                                   # https://<accountid>.r2.cloudflarestorage.com
S3_PUBLIC_URL=                                 # Public CDN base for the bucket, e.g. https://cdn.example.com
NEXT_PUBLIC_UPLOAD_HOST=                       # Hostname part of S3_PUBLIC_URL; next/image refuses hosts not listed in next.config.ts
UPLOAD_MAX_BYTES=104857600                     # Per-file upload ceiling in bytes (default 100 MiB)

# ─── Airtable (RSVP funnel + the YSWS grant sink) ────────────────────────────
# Every Airtable write no-ops with a warning when these are unset, so local dev
# works with no Airtable at all.
AIRTABLE_API_KEY=                              # Personal access token with data.records:read/write on the base below
AIRTABLE_BASE_ID=                              # Half-Life base id (appXXXXXXXXXXXXXX)
AIRTABLE_YSWS_TABLE_ID=                        # Table id of "YSWS Project Submission" (tblXXXXXXXXXXXXXX)
AIRTABLE_RSVP_TABLE_ID=                        # Table id of "RSVPs"
AIRTABLE_UNIFIED_BASE_ID=app3A5kJwYqxMLOgh     # Hack Club unified YSWS base; used to remove rows on un-approval
AIRTABLE_UNIFIED_APPROVED_TABLE=tblzWWGUYHVH7Zyqf  # "Approved Projects" table in the unified base

# ─── Slack (profile enrichment, review notifications) ────────────────────────
SLACK_BOT_TOKEN=                               # xoxb- token; unset disables all Slack side effects
SLACK_REVIEW_CHANNEL=                          # Channel id for reviewer digests

# ─── Machine-to-machine ──────────────────────────────────────────────────────
INTEGRATION_API_KEY=                           # Bearer token for /api/integrations/*; Orchard jobs present this
EXPORT_API_KEY=                                # Narrower bearer accepted only by the read-only participant export

# ─── Program defaults (seed values for the ProgramSettings row) ──────────────
# After the first migration these live in the database and are edited from
# /admin/program. The env vars are only read when seeding a fresh database.
PROGRAM_START_DATE=2026-09-07                  # ISO date of week 1, day 1. All week math derives from this
PROGRAM_TIMEZONE=America/New_York              # IANA zone used for week boundaries and journal effective dates

# ─── Access control ──────────────────────────────────────────────────────────
SUPERADMIN_EMAILS=                             # Comma-separated emails auto-granted ADMIN on first sign-in; keep this to one or two people
REQUIRE_BASICAUTH=false                        # true puts HTTP basic auth in front of the whole site (pre-launch / staging)
BASICAUTH_USERNAME=                            # Only read when REQUIRE_BASICAUTH=true
BASICAUTH_PASSWORD=                            # Only read when REQUIRE_BASICAUTH=true
AIRTABLE_USE_FIELD_IDS=false                   # true writes by Airtable field id (survives column renames). Run `yarn dump-airtable-schema` and fill lib/airtable/schema.ts first
SKIP_YSWS_VERIFICATION_CHECK=false             # true lets unverified accounts submit. Development only
